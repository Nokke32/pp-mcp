# ---- Portfolio Performance MCP Server – example configuration ----
# Copy to .env and adjust:  cp .env.example .env

# ---- Variant A: a single portfolio file (single-source, e.g. local Mac setup) ----
# Host path to the portfolio file (mounted read-only into the container).
PP_HOST_FILE=/path/to/your.portfolio

# Password for AES-encrypted files. Leave empty if unencrypted.
PP_PASSWORD=

# ---- Variant B: multiple portfolio files (multi-source, e.g. server setup) ----
# Host directory with all .portfolio files (mounted read-only to /data/portfolios).
# PP_HOST_PORTFOLIOS_DIR=/path/to/portfolios
# Host path to the JSON config file with the sources (see portfolios.json.example).
# PP_HOST_PORTFOLIOS_CONFIG=./portfolios.json

# MCP transport: streamable-http (default) or sse
MCP_TRANSPORT=streamable-http

# Host port for the MCP server (container port is fixed at 8080)
MCP_SERVER_PORT=8080

# Optional bearer token to protect the HTTP endpoints.
# Empty = NO authentication. REQUIRED when running outside a trusted local network.
MCP_AUTH_TOKEN=

# If true, the server refuses to start when MCP_AUTH_TOKEN is empty – an extra
# safeguard against accidentally running unprotected. Recommended for
# publicly reachable deployments (already set to true in docker-compose.yml).
MCP_REQUIRE_AUTH=false

# Log level for Python logging/uvicorn: DEBUG, INFO (default), WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# ---- Local operation without Docker ----
# When starting directly (python src/main.py), use these instead of
# PP_HOST_FILE/PP_HOST_PORTFOLIOS_DIR:
# PP_FILE_PATH=/path/to/your.portfolio
# or for multi-source:
# PP_PORTFOLIOS_CONFIG=/path/to/portfolios/portfolios.json
