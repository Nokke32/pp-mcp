# ---- Portfolio-Performance MCP Server – Beispielkonfiguration ----
# Kopieren nach .env und anpassen:  cp .env.example .env

# ---- Variante A: eine einzelne Portfolio-Datei (Single-Source, z.B. lokaler Mac-Betrieb) ----
# Host-Pfad zur Portfolio-Datei (wird read-only in den Container gemountet).
PP_HOST_FILE=/path/to/your.portfolio

# Passwort für AES-verschlüsselte Dateien. Leer lassen, wenn unverschlüsselt.
PP_PASSWORD=

# ---- Variante B: mehrere Portfolio-Dateien (Multi-Source, z.B. Server-Betrieb) ----
# Host-Verzeichnis mit allen .portfolio-Dateien (wird read-only nach /data/portfolios gemountet).
# PP_HOST_PORTFOLIOS_DIR=/path/to/portfolios
# Host-Pfad zur JSON-Konfigurationsdatei mit den Quellen (siehe portfolios.json.example).
# PP_HOST_PORTFOLIOS_CONFIG=./portfolios.json

# MCP-Transport: streamable-http (Default) oder sse
MCP_TRANSPORT=streamable-http

# Host-Port für den MCP-Server (Container-Port ist fest 8080)
MCP_SERVER_PORT=8080

# Optionaler Bearer-Token zum Schutz der HTTP-Endpunkte.
# Leer = KEINE Authentifizierung. Bei Betrieb außerhalb des vertrauenswürdigen
# lokalen Netzes PFLICHT setzen.
MCP_AUTH_TOKEN=

# Bei true bricht der Server-Start ab, wenn MCP_AUTH_TOKEN leer ist – zusätzliche
# Absicherung gegen versehentlichen ungeschützten Betrieb. Für öffentlich
# erreichbare Deployments empfohlen (in docker-compose.yml bereits auf true gesetzt).
MCP_REQUIRE_AUTH=false

# ---- Lokaler Betrieb ohne Docker ----
# Beim direkten Start (python src/main.py) statt PP_HOST_FILE/PP_HOST_PORTFOLIOS_DIR:
# PP_FILE_PATH=/path/to/your.portfolio
# oder für Multi-Source:
# PP_PORTFOLIOS_CONFIG=/path/to/portfolios/portfolios.json
